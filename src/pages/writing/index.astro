---
import { type CollectionEntry, getCollection } from 'astro:content'
import Layout from '@/layouts/Layout.astro'
import { config } from '@/config'
import { formatDate } from '@/utils/date'

const posts = await getCollection('writing')
const sortedPosts = posts.sort(
  (a: CollectionEntry<'writing'>, b: CollectionEntry<'writing'>) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
)
---

<Layout
  title={`Writing | ${config.site.title}`}
  description="Notes and articles on software engineering and the tools I use."
  header="Writing"
>
  <ul class="space-y-6" role="list">
    {sortedPosts.map((post) => (
      <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-8">
        <time
          datetime={post.data.date.toISOString()}
          class="min-w-25 text-sm text-neutral-400"
        >
          {formatDate(post.data.date)}
        </time>
        <a
          href={`/writing/${post.id}`}
          class="text-neutral-200 underline decoration-neutral-500 underline-offset-4 transition-colors hover:text-neutral-400"
        >
          {post.data.title}
        </a>
      </li>
    ))}
  </ul>
</Layout>
