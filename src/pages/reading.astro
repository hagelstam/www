---
import Icon from '@/components/Icons.astro'
import Layout from '@/layouts/Layout.astro'
import { config } from '@/config'
import { formatDate } from '@/utils/date'
import fs from 'fs'
import path from 'path'

interface Article {
  date: Date
  title: string
  link: string
  blogName: string
}

const readingPath = path.join(process.cwd(), 'src/content/reading.md')
const articles: Article[] = []

try {
  const content = fs.readFileSync(readingPath, 'utf-8')
  const regex = /^- (\d{2}\.\d{2}\.\d{4}) \[(.*?)\]\((.*?)\) - (.*)$/gm
  let match

  while ((match = regex.exec(content)) !== null) {
    const [day, month, year] = match[1]!.split('.')
    articles.push({
      date: new Date(Date.UTC(Number(year), Number(month) - 1, Number(day))),
      title: match[2]!,
      link: match[3]!,
      blogName: match[4]!,
    })
  }
} catch (error) {
  console.error('error parsing reading list:', error)
}
---

<Layout
  title={`Reading list | ${config.site.title}`}
  description="The latest articles from the logs I follow, updated every night."
  header="Reading list"
>
  <div class="prose prose-neutral prose-invert -mt-3 text-neutral-200">
    <p>
      This page is auto-generated from a GitHub Actions workflow that runs every
      night and fetches the 5 latest articles from my favorite blogs.
    </p>
  </div>

  <ul class="mt-8 space-y-6" role="list">
    {articles.map((article) => (
      <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-8">
        <time
          datetime={article.date.toISOString().slice(0, 10)}
          class="min-w-25 shrink-0 text-sm text-neutral-400"
        >
          {formatDate(article.date)}
        </time>
        <div class="min-w-0 wrap-anywhere">
          <a
            href={article.link}
            target="_blank"
            rel="noopener noreferrer"
            class="text-neutral-200 transition-colors hover:text-neutral-400"
          >
            {article.title}
          </a>
          <span class="ml-2 text-neutral-400">- {article.blogName}</span>
        </div>
      </li>
    ))}
  </ul>

  <div class="mt-12 border-t border-neutral-800 pt-6">
    <a
      href="https://github.com/hagelstam/www/blob/main/reading.go"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-11 items-center text-neutral-400 transition-colors hover:text-neutral-200"
    >
      <Icon name="arrow" />
      <span class="ml-1">view source code</span>
    </a>
  </div>
</Layout>
